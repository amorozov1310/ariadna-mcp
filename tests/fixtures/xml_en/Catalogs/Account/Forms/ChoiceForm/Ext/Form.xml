				<QueryText>SELECT
	Node.Ref AS NodeRef,
	Node.Person AS NodePerson,
	Node.Role AS NodeRole,
	Node.Status AS NodeStatus,
	Node.Account AS NodeAccount
INTO VT_NodeAccounts
FROM
	Catalog.Node AS Node
WHERE
	Node.Role.Type = VALUE(Enum.RoleType.App)
	AND NOT Node.Account = VALUE(Catalog.Account.EmptyRef)
	AND NOT Node.Status = VALUE(Enum.NodeStatus.EmptyRef)

INDEX BY SETS
(
	(Node.Account),
	(Node.Ref) UNIQUE
)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CatalogAccount.Ref AS Ref,
	CatalogAccount.Type AS Type,
	CatalogAccount.DeletionMark AS DeletionMark,
	CatalogAccount.Code AS Code,
	CatalogAccount.Username AS Username,
	CatalogAccount.App AS App,
	CatalogAccount.Attrs AS Attrs,
	ISNULL(Node.NodePerson, VALUE(Catalog.Person.EmptyRef)) AS Person,
	ISNULL(Node.NodeRole, VALUE(Catalog.Role.EmptyRef)) AS Role,
	ISNULL(Node.NodeStatus, VALUE(Enum.NodeStatus.EmptyRef)) AS Status
FROM
	Catalog.Account AS CatalogAccount
		LEFT JOIN VT_NodeAccounts AS Node
		ON CatalogAccount.Ref = Node.NodeAccount
			AND (Node.NodeRef IN
				(SELECT TOP 1
					VT_NodeAccounts.NodeRef AS Ref
				FROM
					VT_NodeAccounts AS VT_NodeAccounts
				WHERE
					VT_NodeAccounts.NodeAccount = CatalogAccount.Ref
				ORDER BY
					Ref DESC))</QueryText>
