#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает склад, который подставляется в новые документы.
//
// Возвращаемое значение:
//   СправочникСсылка.Склады
//
Функция СкладПоУмолчанию() Экспорт

	Возврат Справочники.Склады.ОсновнойСклад;

КонецФункции

// Возвращает склады указанного типа.
//
// Параметры:
//   ТипСклада - ПеречислениеСсылка.ТипыСкладов
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.Склады
//
Функция СкладыПоТипу(ТипСклада) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.ТипСклада = &ТипСклада";
	Запрос.УстановитьПараметр("ТипСклада", ТипСклада);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)

	Если Параметры.Свойство("ТипСклада") Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(СкладыПоТипу(Параметры.ТипСклада));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
